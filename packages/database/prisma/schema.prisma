generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

enum AdminUserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum PermissionScope {
  MODULE
  PAGE
  ACTION
}

enum ActorType {
  EMPLOYEE
  SYSTEM
  CUSTOMER
  AFFILIATE
}

enum SourceApp {
  STOREFRONT
  OPERATIONS
  ADMIN
  API
  WORKER
}

enum ProductStatus {
  DRAFT
  PHOTOGRAPHED
  AI_PROCESSING
  AI_PROCESSED
  CALIBRATION_PENDING
  CALIBRATED
  BARCODE_ASSIGNED
  REVIEW_PENDING
  REWORK_REQUIRED
  APPROVED
  READY_FOR_STORAGE
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum ProductBatchStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum ProductImageType {
  FRONT
  BACK
  LABEL
  DEFECT
  DETAIL
  SOCIAL_CARD
}

enum ProductGender {
  WOMEN
  MEN
  KIDS
  UNISEX
}

enum ProductFitType {
  SLIM
  REGULAR
  RELAXED
  OVERSIZED
  UNKNOWN
}

enum ProductStretchLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  UNKNOWN
}

enum ProductFabricWeight {
  LIGHT
  REGULAR
  HEAVY
  UNKNOWN
}

enum ConditionGrade {
  LIKE_NEW
  EXCELLENT
  GOOD
  FAIR
}

enum AIExtractionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum AIFieldDecisionSource {
  AI_PROPOSED
  HUMAN_ACCEPTED
  HUMAN_EDITED
  HUMAN_ENTERED
}

enum ReviewResult {
  APPROVED
  REWORK_REQUIRED
  REJECTED
}

enum MeasurementSource {
  AI_ACCEPTED
  HUMAN_EDITED
  HUMAN_ENTERED
}

enum DefectSeverity {
  MINOR
  MAJOR
}

enum InventoryItemStatus {
  PENDING_STOCK_IN
  AVAILABLE
  RESERVED
  /// Half paid, held off sale for seven days while the shopper finds the rest.
  /// Distinct from RESERVED so the warehouse can tell a cart lock that expires
  /// in minutes from a garment that has a customer's money against it.
  DEPOSIT_HELD
  PAID
  PICKED
  PACKED
  DELIVERED
  RETURNED
  LOST
}

enum InventoryMovementType {
  LOCATION_ASSIGNED
  STOCK_IN
  MOVE
  ADJUST
}

enum WarehouseLocationStatus {
  ACTIVE
  FULL
  INACTIVE
}

model Employee {
  id                          String                @id @default(uuid())
  employeeCode                String                @unique
  name                        String
  phone                       String?               @unique
  status                      EmployeeStatus        @default(ACTIVE)
  roles                       EmployeeRole[]
  auditLogs                   AuditLog[]
  createdProducts             Product[]             @relation("ProductCreatedBy")
  approvedProducts            Product[]             @relation("ProductApprovedBy")
  uploadedProductImages       ProductImage[]        @relation("ProductImageUploadedBy")
  reviewedMeasurements        ProductMeasurement[]  @relation("ProductMeasurementReviewedBy")
  reviewedAIFieldDecisions    AIFieldDecision[]     @relation("AIFieldDecisionReviewedBy")
  productReviews              ProductReview[]       @relation("ProductReviewReviewer")
  createdProductBatches       ProductBatch[]        @relation("ProductBatchCreatedBy")
  inventoryItemsCreated       InventoryItem[]       @relation("InventoryItemCreatedBy")
  inventoryMovements          InventoryMovement[]   @relation("InventoryMovementEmployee")
  assignedFulfillments        OrderFulfillment[]    @relation("FulfillmentAssignedPicker")
  assignedPackingTasks        OrderFulfillment[]    @relation("FulfillmentAssignedPacker")
  packingStartedFulfillments  OrderFulfillment[]    @relation("FulfillmentPackingStartedBy")
  packedFulfillments          OrderFulfillment[]    @relation("FulfillmentPackedBy")
  dispatchedFulfillments      OrderFulfillment[]    @relation("FulfillmentDispatchedBy")
  pickupConfirmedFulfillments OrderFulfillment[]    @relation("FulfillmentPickupConfirmedBy")
  afterSaleFulfillments       OrderFulfillment[]    @relation("FulfillmentAfterSaleOwner")
  verifiedFulfillmentItems    FulfillmentItem[]     @relation("FulfillmentItemVerifiedBy")
  fulfillmentEvents           FulfillmentEvent[]    @relation("FulfillmentEventActor")
  relatedFulfillmentEvents    FulfillmentEvent[]    @relation("FulfillmentEventRelatedEmployee")
  deliveryRider               DeliveryRider?        @relation("DeliveryRiderEmployee")
  afterSaleCases              CustomerServiceCase[] @relation("CustomerServiceCaseOwner")
  adminUser                   AdminUser?            @relation("AdminUserLinkedEmployee")
  homeNodeId                  String?
  homeNode                    FulfillmentNode?      @relation("FulfillmentNodeStaff", fields: [homeNodeId], references: [id], onDelete: SetNull)
  sentToNodeFulfillments      OrderFulfillment[]    @relation("FulfillmentSentToNodeBy")
  arrivedAtNodeFulfillments   OrderFulfillment[]    @relation("FulfillmentArrivedAtNodeBy")
  deliveryCostFulfillments    OrderFulfillment[]    @relation("FulfillmentDeliveryCostBy")
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  @@index([homeNodeId, status])
}

model AdminUser {
  id                     String                @id @default(uuid())
  name                   String
  email                  String?               @unique
  loginAccount           String                @unique
  phone                  String?               @unique
  passwordHash           String?
  inviteTokenHash        String?
  inviteExpiresAt        DateTime?
  status                 AdminUserStatus       @default(ACTIVE)
  linkedEmployeeId       String?               @unique
  linkedEmployee         Employee?             @relation("AdminUserLinkedEmployee", fields: [linkedEmployeeId], references: [id], onDelete: SetNull)
  roles                  UserRole[]
  customerServiceCases   CustomerServiceCase[] @relation("CustomerServiceCaseCreatedBy")
  assignedServiceCases   CustomerServiceCase[] @relation("CustomerServiceCaseAssignee")
  escalatedServiceCases  CustomerServiceCase[] @relation("CustomerServiceCaseEscalatedBy")
  customerServiceNotes   CustomerServiceNote[] @relation("CustomerServiceNoteAuthor")
  fulfillmentEvents      FulfillmentEvent[]    @relation("FulfillmentEventAdminActor")
  deliveryAssignments    DeliveryAssignment[]  @relation("DeliveryAssignmentAssignedBy")
  deliveryRider          DeliveryRider?        @relation("DeliveryRiderAccount")
  customerCodeAttempts   CustomerCodeAttempt[] @relation("CustomerCodeAttemptActor")
  auditLogs              AuditLog[]            @relation("AuditLogAdminUser")
  reviewedPayments       Payment[]             @relation("PaymentReviewedBy")
  resolvedMpesaCallbacks MpesaCallback[]       @relation("MpesaCallbackResolvedBy")
  recordedRefunds        RefundRecord[]        @relation("RefundRecordedBy")
  requestedRefunds       RefundRequest[]       @relation("RefundRequestedBy")
  reviewedRefunds        RefundRequest[]       @relation("RefundReviewedBy")
  recordedPayouts        Payout[]              @relation("PayoutPaidBy")
  lastLoginAt            DateTime?
  lockedAt               DateTime?
  disabledAt             DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([linkedEmployeeId])
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  employees   EmployeeRole[]
  adminUsers  UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  module      String
  scope       PermissionScope  @default(ACTION)
  page        String?
  action      String?
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  adminUserId String
  roleId      String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([adminUserId, roleId])
}

model EmployeeRole {
  employeeId String
  roleId     String
  employee   Employee @relation(fields: [employeeId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])
  createdAt  DateTime @default(now())

  @@id([employeeId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
}

model AuditLog {
  id               String     @id @default(uuid())
  actorType        ActorType
  actorId          String?
  actorAdminUserId String?
  employee         Employee?  @relation(fields: [actorId], references: [id])
  adminUser        AdminUser? @relation("AuditLogAdminUser", fields: [actorAdminUserId], references: [id], onDelete: SetNull)
  sourceApp        SourceApp
  module           String
  entityType       String
  entityId         String?
  action           String
  beforeJson       Json?
  afterJson        Json?
  reason           String?
  createdAt        DateTime   @default(now())

  @@index([module, entityType, entityId])
  @@index([actorType, actorId])
  @@index([actorAdminUserId, createdAt])
  @@index([createdAt])
}

model SystemSetting {
  key                 String   @id
  valueJson           Json
  scope               String   @default("GLOBAL")
  updatedByEmployeeId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Product {
  id                   String                       @id @default(uuid())
  productCode          String                       @unique
  batchId              String?
  batchItemNumber      Int?
  barcode              String?                      @unique
  status               ProductStatus                @default(DRAFT)
  title                String?
  description          String?
  category             String?
  subcategory          String?
  brand                String?
  color                String?
  pattern              String?
  sleeveType           String?
  fitType              ProductFitType?
  stretchLevel         ProductStretchLevel?
  fabricWeight         ProductFabricWeight?
  material             String?
  tags                 String[]                     @default([])
  detailSourceVersion  Int                          @default(0)
  gender               ProductGender?
  kidsAgeRange         String?
  tagSize              String?
  shoeSizeSystem       String?
  shoeType             String?
  shoePairConfirmed    Boolean                      @default(false)
  shoeConditionNotes   String?
  finalSizeLabel       String?
  ukSizeLabel          String?
  conditionGrade       ConditionGrade?
  priceKsh             Int?
  labelPrintedAt       DateTime?
  labelAppliedAt       DateTime?
  createdByEmployeeId  String?
  approvedByEmployeeId String?
  createdBy            Employee?                    @relation("ProductCreatedBy", fields: [createdByEmployeeId], references: [id])
  approvedBy           Employee?                    @relation("ProductApprovedBy", fields: [approvedByEmployeeId], references: [id])
  batch                ProductBatch?                @relation(fields: [batchId], references: [id], onDelete: SetNull)
  images               ProductImage[]
  measurements         ProductMeasurement[]
  aiExtractions        AIExtraction[]
  defects              ProductDefect[]
  reviews              ProductReview[]
  detailProfiles       ProductDetailProfile[]
  runThroughVideoItems RunThroughVideoItem[]
  detailAssets         ProductDetailAsset[]
  detailGenerationJobs ProductDetailGenerationJob[]
  inventoryItem        InventoryItem?
  inventoryMovements   InventoryMovement[]
  affiliateLinks       AffiliateLink[]
  affiliateClicks      AffiliateClick[]
  collectionItems      CollectionItem[]
  shareCards           ShareCard[]
  publishedAt          DateTime?
  unpublishedAt        DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@unique([batchId, batchItemNumber])
  @@index([status, publishedAt])
  @@index([batchId, batchItemNumber])
  @@index([category, finalSizeLabel, priceKsh])
  @@index([category, subcategory])
  @@index([gender, kidsAgeRange])
  @@index([conditionGrade])
}

model ProductBatch {
  id                   String                       @id @default(uuid())
  batchCode            String                       @unique
  status               ProductBatchStatus           @default(OPEN)
  targetCount          Int                          @default(10)
  intakeCategory       String?
  createdByEmployeeId  String?
  createdBy            Employee?                    @relation("ProductBatchCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  products             Product[]
  detailGenerationJobs ProductDetailGenerationJob[]
  note                 String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@index([status, createdAt])
  @@index([createdByEmployeeId])
}

model WarehouseLocation {
  id             String                  @id @default(uuid())
  locationCode   String                  @unique
  zoneCode       String?
  rackCode       String?
  binCode        String?
  qrCode         String?                 @unique
  capacity       Int                     @default(100)
  status         WarehouseLocationStatus @default(ACTIVE)
  active         Boolean                 @default(true)
  note           String?
  inventoryItems InventoryItem[]
  movementsFrom  InventoryMovement[]     @relation("MovementFromLocation")
  movementsTo    InventoryMovement[]     @relation("MovementToLocation")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status, locationCode])
  @@index([active, locationCode])
  @@index([zoneCode, rackCode, binCode])
}

model InventoryItem {
  id                  String              @id @default(uuid())
  productId           String              @unique
  barcode             String              @unique
  status              InventoryItemStatus @default(PENDING_STOCK_IN)
  locationId          String?
  checkedInAt         DateTime?
  createdByEmployeeId String?
  product             Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  location            WarehouseLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy           Employee?           @relation("InventoryItemCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  movements           InventoryMovement[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status, locationId])
  @@index([createdByEmployeeId])
}

model InventoryMovement {
  id              String                @id @default(uuid())
  inventoryItemId String
  productId       String
  movementType    InventoryMovementType
  fromLocationId  String?
  toLocationId    String?
  employeeId      String?
  reason          String?
  inventoryItem   InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromLocation    WarehouseLocation?    @relation("MovementFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation      WarehouseLocation?    @relation("MovementToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  employee        Employee?             @relation("InventoryMovementEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt       DateTime              @default(now())

  @@index([inventoryItemId, createdAt])
  @@index([productId, createdAt])
  @@index([movementType, createdAt])
  @@index([employeeId])
}

model ProductImage {
  id                   String           @id @default(uuid())
  productId            String
  type                 ProductImageType
  originalUrl          String
  publicUrl            String?
  sortOrder            Int              @default(0)
  isRequired           Boolean          @default(false)
  uploadedByEmployeeId String?
  product              Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadedBy           Employee?        @relation("ProductImageUploadedBy", fields: [uploadedByEmployeeId], references: [id])
  defects              ProductDefect[]
  createdAt            DateTime         @default(now())

  @@index([productId, type])
  @@index([uploadedByEmployeeId])
}

model ProductMeasurement {
  id                   String             @id @default(uuid())
  productId            String
  measurementType      String
  aiValueCm            Decimal?           @db.Decimal(6, 2)
  aiConfidence         Decimal?           @db.Decimal(4, 3)
  finalValueCm         Decimal?           @db.Decimal(6, 2)
  finalSource          MeasurementSource?
  manualLineImageId    String?
  manualLineStartX     Decimal?           @db.Decimal(5, 4)
  manualLineStartY     Decimal?           @db.Decimal(5, 4)
  manualLineEndX       Decimal?           @db.Decimal(5, 4)
  manualLineEndY       Decimal?           @db.Decimal(5, 4)
  reviewedByEmployeeId String?
  reviewedAt           DateTime?
  product              Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewedBy           Employee?          @relation("ProductMeasurementReviewedBy", fields: [reviewedByEmployeeId], references: [id])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([productId, measurementType])
  @@index([measurementType])
  @@index([reviewedByEmployeeId])
}

model AIExtraction {
  id                   String             @id @default(uuid())
  productId            String
  provider             String?
  model                String?
  promptVersion        String?
  requestJson          Json?
  inputImageIds        Json?
  rawOutputJson        Json?
  normalizedOutputJson Json?
  status               AIExtractionStatus @default(PENDING)
  errorMessage         String?
  failureCode          String?
  retryCount           Int                @default(0)
  startedAt            DateTime?
  completedAt          DateTime?
  latencyMs            Int?
  inputTokens          Int?
  outputTokens         Int?
  estimatedCostUsd     Decimal?           @db.Decimal(10, 6)
  product              Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  fieldDecisions       AIFieldDecision[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([productId, status])
  @@index([createdAt])
}

model AIFieldDecision {
  id                        String                @id @default(uuid())
  extractionId              String
  fieldName                 String
  aiValueJson               Json?
  finalValueJson            Json?
  confidence                Decimal?              @db.Decimal(4, 3)
  evidenceImageIds          Json?
  source                    AIFieldDecisionSource @default(AI_PROPOSED)
  requiresHumanConfirmation Boolean               @default(false)
  reviewedByEmployeeId      String?
  reviewedAt                DateTime?
  extraction                AIExtraction          @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  reviewedBy                Employee?             @relation("AIFieldDecisionReviewedBy", fields: [reviewedByEmployeeId], references: [id], onDelete: SetNull)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  @@unique([extractionId, fieldName])
  @@index([fieldName, source])
  @@index([reviewedByEmployeeId])
}

model ProductDefect {
  id                      String         @id @default(uuid())
  productId               String
  defectType              String
  severity                DefectSeverity
  description             String
  customerSafeDescription String?
  imageId                 String?
  product                 Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  image                   ProductImage?  @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt               DateTime       @default(now())

  @@index([productId])
  @@index([defectType])
  @@index([imageId])
}

model ProductReview {
  id                 String       @id @default(uuid())
  productId          String
  reviewerEmployeeId String?
  result             ReviewResult
  reason             String?
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewer           Employee?    @relation("ProductReviewReviewer", fields: [reviewerEmployeeId], references: [id])
  createdAt          DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([reviewerEmployeeId])
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CheckoutDraftStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  /// Deposit received; the garment is held and the balance is due by balanceDueAt.
  DEPOSIT_PAID
  /// The seven days lapsed without the balance. Stock is back on sale and a
  /// partial refund is owed — kept apart from CANCELLED because money is open.
  DEPOSIT_EXPIRED
  PAID
  CANCELLED
  EXPIRED
  FULFILLING
  COMPLETED
  REFUNDED
}

enum FulfillmentMethod {
  PICKUP
  KIKUYU_LOCAL_DELIVERY
}

enum OrderCurrency {
  KES
}

enum PaymentProvider {
  MPESA
}

enum OrderPaymentPlan {
  FULL
  DEPOSIT_50
}

enum PaymentKind {
  FULL
  DEPOSIT
  BALANCE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  TIMEOUT
  EXPIRED
  MANUAL_REVIEW
}

enum FulfillmentStatus {
  PAID
  PICKING
  READY_TO_PACK
  PACKED
  IN_TRANSIT_TO_NODE
  ARRIVED_AT_NODE
  READY_FOR_PICKUP
  READY_FOR_DISPATCH
  OUT_FOR_DELIVERY
  DELIVERY_FAILED
  RETURNING_TO_NODE
  COMPLETED
  EXCEPTION
}

enum FulfillmentItemStatus {
  PENDING
  VERIFIED
}

enum PackagingMethod {
  BAG
  BOX
  OTHER
}

enum PickupVerificationMethod {
  ORDER_NUMBER
  PHONE
  PICKUP_CODE
}

enum DeliveryRiderType {
  INTERNAL
  EXTERNAL
}

enum FulfillmentExceptionReason {
  ITEM_NOT_FOUND
  BARCODE_MISMATCH
  ITEM_DAMAGED
  CUSTOMER_CANCELLED
  DELIVERY_FAILED
  ITEM_SOLD_OFFLINE
  NODE_NOT_RECEIVED
  WRONG_NODE
  CUSTOMER_UNREACHABLE
  OTHER
}

/**
 * Who physically holds the package right now. Every order can answer "where is
 * it and who is responsible" from this one field, without replaying the log.
 */
enum FulfillmentHolderType {
  WAREHOUSE
  IN_TRANSIT
  NODE
  RIDER
  CUSTOMER
}

/**
 * How a delivery ended. Both ways need the customer's code.
 */
enum DeliveryCompletionMethod {
  HANDED_TO_CUSTOMER
  AUTHORIZED_DROP_OFF
}

/**
 * Why a rider came back with the package still in hand.
 */
enum DeliveryFailureReason {
  NO_ANSWER
  PHONE_UNREACHABLE
  WRONG_ADDRESS
  CUSTOMER_REQUESTED_LATER
  CUSTOMER_REFUSED
  OTHER
}

/**
 * Which handover a customer code was issued for.
 */
enum CustomerCodePurpose {
  DELIVERY
  PICKUP
}

enum FulfillmentNodeType {
  WAREHOUSE
  STORE
}

enum FulfillmentNodeStatus {
  ACTIVE
  INACTIVE
}

enum NotificationChannel {
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum NotificationAudience {
  CUSTOMER
  AFFILIATE
  NODE
  WAREHOUSE
  ADMIN
}

enum RefundKind {
  AFTER_SALE_RETURN
  UNFULFILLABLE_ORDER
  DUPLICATE_PAYMENT
  OVERPAYMENT
  LAPSED_DEPOSIT
}

enum PaymentReviewDecision {
  SETTLED
  NOT_RECEIVED
  REFUNDED
}

enum MpesaCallbackProcessingStatus {
  APPLIED
  DUPLICATE
  IGNORED
  MANUAL_REVIEW
}

enum AffiliateStatus {
  ACTIVE
  DISABLED
}

enum AffiliateLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

enum AffiliateLinkType {
  STORE
  PRODUCT
  COLLECTION
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CampaignChannel {
  WHATSAPP
  STATUS
  TIKTOK
  FACEBOOK
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AffiliateAssetStatus {
  PROCESSING
  READY
  FAILED
}

enum CommissionStatus {
  PENDING
  CONFIRMED
  REJECTED
  PAID
}

/// Who a weekly payout went to: a promoter's commission or a rider's delivery pay.
enum PayoutPayeeType {
  AFFILIATE
  RIDER
}

enum CustomerServiceCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CustomerServiceCaseType {
  // PAYMENT
  PAYMENT_FAILED
  PAID_BUT_ORDER_MISSING
  DUPLICATE_PAYMENT
  PAYMENT_PENDING
  WRONG_AMOUNT
  // DELIVERY
  ORDER_LATE
  CUSTOMER_UNREACHABLE
  WRONG_ADDRESS
  RIDER_ISSUE
  PACKAGE_MISSING
  DELIVERY_CODE_NOT_RECEIVED
  // PRODUCT
  WRONG_ITEM
  DAMAGED_ITEM
  MISSING_ITEM
  SIZE_ISSUE
  PRODUCT_NOT_AS_EXPECTED
  // AFTER SALES
  RETURN_REQUEST
  EXCHANGE_REQUEST
  REFUND_REQUEST
  // Anything the taxonomy above does not name yet.
  OTHER
}

enum CustomerServicePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Who owns a case once customer service cannot finish it alone.
enum CustomerServiceEscalationTarget {
  FULFILLMENT
  FINANCE
  ADMIN
}

/// Approval gate in front of money leaving the business. A refund is only ever
/// executed in M-Pesa by finance; this is the request that authorises them to.
enum RefundRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REFUNDED
  CANCELLED
}

enum CustomerServiceIssueType {
  PAYMENT
  PICKUP
  DELIVERY
  AFTER_SALE
  ORDER
  OTHER
}

model Customer {
  id                         String                 @id @default(uuid())
  // Google sign-in is optional. Guests check out with an M-Pesa phone only, so
  // every Google-specific column has to tolerate a customer that never signed in.
  googleSubjectId            String?                @unique
  email                      String?
  normalizedEmail            String?                @unique
  // Normalized 2547xxxxxxxx form of the M-Pesa phone, set on guest records only.
  // It is how a returning guest is recognised without signing in; accounts stay
  // unreachable this way so an unauthenticated checkout cannot write to them.
  normalizedPhone            String?                @unique
  emailVerified              Boolean                @default(false)
  displayName                String?
  avatarUrl                  String?
  phone                      String?
  defaultAddress             String?
  preferredFulfillmentMethod FulfillmentMethod?
  status                     CustomerStatus         @default(ACTIVE)
  lastLoginAt                DateTime?
  checkoutDrafts             CheckoutDraft[]
  orders                     Order[]
  affiliateProfile           Affiliate?
  affiliateClicks            AffiliateClick[]
  affiliateAttributions      AffiliateAttribution[]
  customerServiceCases       CustomerServiceCase[]
  customerServiceNotes       CustomerServiceNote[]
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model CheckoutDraft {
  id                String              @id @default(uuid())
  customerId        String
  status            CheckoutDraftStatus @default(ACTIVE)
  fulfillmentMethod FulfillmentMethod   @default(PICKUP)
  deliveryAddress   String?
  deliveryNote      String?
  fulfillmentNodeId String?
  whatsappPhone     String?
  itemSubtotalKsh   Int                 @default(0)
  deliveryFeeKsh    Int                 @default(0)
  totalKsh          Int                 @default(0)
  currency          OrderCurrency       @default(KES)
  expiresAt         DateTime?
  convertedOrderId  String?             @unique
  customer          Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  convertedOrder    Order?              @relation("CheckoutDraftConvertedOrder", fields: [convertedOrderId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([customerId, status, updatedAt])
  @@index([status, expiresAt])
}

model Order {
  id                   String                @id @default(uuid())
  orderNumber          String                @unique
  customerId           String
  status               OrderStatus           @default(DRAFT)
  fulfillmentMethod    FulfillmentMethod
  pickupCode           String?               @unique
  deliveryAddress      String?
  deliveryNote         String?
  itemSubtotalKsh      Int
  deliveryFeeKsh       Int                   @default(0)
  totalKsh             Int
  currency             OrderCurrency         @default(KES)
  /// FULL is one M-Pesa payment for the whole total. DEPOSIT_50 is two: half
  /// now to hold the garment, the rest within seven days.
  paymentPlan          OrderPaymentPlan      @default(FULL)
  /// Both are zero on a FULL order. On a deposit order they are frozen at
  /// checkout so a later price edit cannot move what the shopper still owes.
  depositKsh           Int                   @default(0)
  balanceKsh           Int                   @default(0)
  depositPaidAt        DateTime?
  /// The moment the hold lapses. Null until the deposit actually clears.
  balanceDueAt         DateTime?
  affiliateId          String?
  affiliateSource      String?
  affiliatePlacement   String?
  affiliateCampaign    String?
  fulfillmentNodeId    String?
  whatsappPhone        String?
  customer             Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  fulfillmentNode      FulfillmentNode?      @relation(fields: [fulfillmentNodeId], references: [id], onDelete: SetNull)
  affiliate            Affiliate?            @relation("OrderAffiliate", fields: [affiliateId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  payments             Payment[]
  fulfillment          OrderFulfillment?
  fulfillmentEvents    FulfillmentEvent[]
  deliveryAssignments  DeliveryAssignment[]
  affiliateAttribution AffiliateAttribution?
  commission           Commission?
  customerServiceCases CustomerServiceCase[]
  customerServiceNotes CustomerServiceNote[]
  afterSaleReturns     AfterSaleReturn[]
  refundRequests       RefundRequest[]
  afterSaleEvents      AfterSaleEvent[]
  refunds              RefundRecord[]
  codeAttempts         CustomerCodeAttempt[]
  notifications        Notification[]
  sourceDraft          CheckoutDraft?        @relation("CheckoutDraftConvertedOrder")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([affiliateId, createdAt])
  @@index([fulfillmentNodeId, status, createdAt])
  /// Drives the sweep that releases garments whose balance never arrived.
  @@index([status, balanceDueAt])
}

model OrderItem {
  id                String             @id @default(uuid())
  orderId           String
  productId         String
  unitPriceKsh      Int
  quantity          Int                @default(1)
  lineTotalKsh      Int
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  snapshot          OrderSnapshot?
  afterSaleReturn   AfterSaleReturn?
  fulfillmentItem   FulfillmentItem?
  fulfillmentEvents FulfillmentEvent[]
  createdAt         DateTime           @default(now())

  @@unique([orderId, productId])
  @@index([productId])
}

model OrderSnapshot {
  id             String          @id @default(uuid())
  orderItemId    String          @unique
  productCode    String
  barcode        String?
  title          String
  category       String?
  subcategory    String?
  brand          String?
  color          String?
  sizeLabel      String?
  conditionGrade ConditionGrade?
  imageUrl       String?
  measurements   Json?
  defects        Json?
  unitPriceKsh   Int
  orderItem      OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())

  @@index([productCode])
  @@index([barcode])
}

model Payment {
  id                        String                 @id @default(uuid())
  orderId                   String
  provider                  PaymentProvider        @default(MPESA)
  /// Which leg of the order this is. A DEPOSIT never settles the order into
  /// fulfilment; only FULL or BALANCE does.
  kind                      PaymentKind            @default(FULL)
  status                    PaymentStatus          @default(PENDING)
  amountKsh                 Int
  currency                  OrderCurrency          @default(KES)
  phone                     String
  idempotencyKey            String                 @unique
  providerMerchantRequestId String?
  providerCheckoutRequestId String?                @unique
  providerReceiptNumber     String?                @unique
  providerResultCode        Int?
  providerResultDescription String?
  providerResponseJson      Json?
  requestedAt               DateTime               @default(now())
  expiresAt                 DateTime?
  completedAt               DateTime?
  providerQueryCount        Int                    @default(0)
  providerQueryAt           DateTime?
  providerQueryResultCode   Int?
  providerQueryDescription  String?
  reviewDecision            PaymentReviewDecision?
  reviewedByAdminUserId     String?
  reviewedAt                DateTime?
  reviewNote                String?
  order                     Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewedByAdminUser       AdminUser?             @relation("PaymentReviewedBy", fields: [reviewedByAdminUserId], references: [id], onDelete: SetNull)
  callbacks                 MpesaCallback[]
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([orderId, status])
  @@index([orderId, kind, status])
  @@index([status, requestedAt])
  @@index([phone, status])
  @@index([providerMerchantRequestId])
  @@index([status, providerQueryAt])
}

model OrderFulfillment {
  id                          String                      @id @default(uuid())
  orderId                     String                      @unique
  status                      FulfillmentStatus           @default(PAID)
  assignedPickerEmployeeId    String?
  /// Who the supervisor gave this parcel to. A packer may only pack parcels
  /// assigned to them; an unassigned parcel is nobody's until someone with the
  /// assign permission hands it out.
  assignedPackerEmployeeId    String?
  packingStartedByEmployeeId  String?
  packedByEmployeeId          String?
  dispatchedByEmployeeId      String?
  pickupConfirmedByEmployeeId String?
  afterSaleOwnerEmployeeId    String?
  deliveryRiderId             String?
  deliveryRiderName           String?
  deliveryRiderPhone          String?
  /// This order's rider pay in KSh, chosen by the store when it hands the
  /// parcel to a rider: 50 or 100, nothing else. The rider earns it only once
  /// the delivery is completed with the customer's code. Cleared when a failed
  /// parcel is back at the store, so the next hand-off has to choose again.
  riderFeeKsh                 Int?
  riderFeeSetByEmployeeId     String?
  /// The weekly payout that paid this order's rider fee; null while unpaid.
  riderFeePayoutId            String?
  riderFeePayout              Payout?                     @relation("FulfillmentRiderFeePayout", fields: [riderFeePayoutId], references: [id], onDelete: Restrict)
  fulfillmentNodeId           String?
  packageCode                 String?                     @unique
  /// When this parcel's routing label (the one with the QR code) was last sent
  /// to the printer. A parcel is not handed to the transfer run to its store
  /// until this is set: a box without its sticker cannot be scanned in there.
  packageLabelPrintedAt       DateTime?
  packageLabelPrintedByEmployeeId String?
  sentToNodeByEmployeeId      String?
  sentToNodeAt                DateTime?
  arrivedAtNodeByEmployeeId   String?
  arrivedAtNodeAt             DateTime?
  nodeReceiptNote             String?
  actualDeliveryCostKsh       Int?
  deliveryCostNote            String?
  deliveryCostByEmployeeId    String?
  deliveryCostRecordedAt      DateTime?
  exceptionReason             FulfillmentExceptionReason?
  exceptionNote               String?
  exceptionFromStatus         FulfillmentStatus?
  exceptionResolvedAt         DateTime?
  packingStatus               String?
  packingNote                 String?
  packagingMethod             PackagingMethod?
  packageCount                Int?
  pickedAt                    DateTime?
  packingStartedAt            DateTime?
  packedAt                    DateTime?
  readyForPickupAt            DateTime?
  readyForDispatchAt          DateTime?
  dispatchedAt                DateTime?
  outForDeliveryAt            DateTime?
  // Who is holding the package right now, and which node/rider that is.
  currentHolderType           FulfillmentHolderType       @default(WAREHOUSE)
  currentHolderId             String?
  currentHolderLabel          String?
  /**
   * The customer's delivery code, stored only as a salted pbkdf2 hash. Nobody
   * -- rider, store, customer service or this API -- can read it back; the
   * plaintext exists only inside the dispatch transaction that texts it.
   */
  deliveryCodeHash            String?
  // The same code in readable form, for the customer's own order page only.
  // It exists because SMS is not live yet and a code nobody can read is a
  // delivery nobody can complete. Redacted from every operations and rider
  // response; see docs/modules/delivery-code-and-riders.md.
  deliveryCode                String?
  deliveryCodeIssuedAt        DateTime?
  deliveryCodeSentCount       Int                         @default(0)
  /**
   * Shared by both handovers: an order is either pickup or delivery, so one
   * attempt budget and one lock cover the delivery code and the pickup code.
   */
  customerCodeVerifiedAt      DateTime?
  customerCodeFailedAttempts  Int                         @default(0)
  customerCodeLockedAt        DateTime?
  deliveryCompletionMethod    DeliveryCompletionMethod?
  dropOffPhotoObject          String?
  dropOffNote                 String?
  deliveryFailureReason       DeliveryFailureReason?
  deliveryFailureNote         String?
  deliveryAttemptCount        Int                         @default(0)
  deliveryFailedAt            DateTime?
  returningToNodeAt           DateTime?
  pickupVerificationMethod    PickupVerificationMethod?
  pickupVerificationValue     String?
  pickupNote                  String?
  completedAt                 DateTime?
  order                       Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignedPicker              Employee?                   @relation("FulfillmentAssignedPicker", fields: [assignedPickerEmployeeId], references: [id], onDelete: SetNull)
  assignedPacker              Employee?                   @relation("FulfillmentAssignedPacker", fields: [assignedPackerEmployeeId], references: [id], onDelete: SetNull)
  packingStartedBy            Employee?                   @relation("FulfillmentPackingStartedBy", fields: [packingStartedByEmployeeId], references: [id], onDelete: SetNull)
  packedBy                    Employee?                   @relation("FulfillmentPackedBy", fields: [packedByEmployeeId], references: [id], onDelete: SetNull)
  dispatchedBy                Employee?                   @relation("FulfillmentDispatchedBy", fields: [dispatchedByEmployeeId], references: [id], onDelete: SetNull)
  pickupConfirmedBy           Employee?                   @relation("FulfillmentPickupConfirmedBy", fields: [pickupConfirmedByEmployeeId], references: [id], onDelete: SetNull)
  afterSaleOwner              Employee?                   @relation("FulfillmentAfterSaleOwner", fields: [afterSaleOwnerEmployeeId], references: [id], onDelete: SetNull)
  fulfillmentNode             FulfillmentNode?            @relation(fields: [fulfillmentNodeId], references: [id], onDelete: SetNull)
  sentToNodeBy                Employee?                   @relation("FulfillmentSentToNodeBy", fields: [sentToNodeByEmployeeId], references: [id], onDelete: SetNull)
  arrivedAtNodeBy             Employee?                   @relation("FulfillmentArrivedAtNodeBy", fields: [arrivedAtNodeByEmployeeId], references: [id], onDelete: SetNull)
  deliveryCostBy              Employee?                   @relation("FulfillmentDeliveryCostBy", fields: [deliveryCostByEmployeeId], references: [id], onDelete: SetNull)
  deliveryRider               DeliveryRider?              @relation(fields: [deliveryRiderId], references: [id], onDelete: SetNull)
  items                       FulfillmentItem[]
  deliveryAssignments         DeliveryAssignment[]
  events                      FulfillmentEvent[]
  codeAttempts                CustomerCodeAttempt[]
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  @@index([status, updatedAt])
  @@index([assignedPickerEmployeeId])
  @@index([assignedPackerEmployeeId])
  @@index([packedByEmployeeId])
  @@index([dispatchedByEmployeeId])
  @@index([deliveryRiderId])
  @@index([fulfillmentNodeId, status, updatedAt])
  @@index([currentHolderType, status])
  @@index([status, completedAt])
  @@index([riderFeePayoutId])
}

model FulfillmentItem {
