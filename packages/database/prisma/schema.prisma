model FulfillmentEvent {
  id                String                      @id @default(uuid())
  idempotencyKey    String?                     @unique
  fulfillmentId     String
  orderId           String
  actorEmployeeId   String?
  actorAdminUserId  String?
  relatedEmployeeId String?
  deliveryRiderId   String?
  orderItemId       String?
  action            String
  oldStatus         FulfillmentStatus?
  newStatus         FulfillmentStatus
  note              String?
  expectedBarcode   String?
  scannedBarcode    String?
  exceptionReason   FulfillmentExceptionReason?
  fulfillment       OrderFulfillment            @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  order             Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorEmployee     Employee?                   @relation("FulfillmentEventActor", fields: [actorEmployeeId], references: [id], onDelete: SetNull)
  actorAdminUser    AdminUser?                  @relation("FulfillmentEventAdminActor", fields: [actorAdminUserId], references: [id], onDelete: SetNull)
  relatedEmployee   Employee?                   @relation("FulfillmentEventRelatedEmployee", fields: [relatedEmployeeId], references: [id], onDelete: SetNull)
  deliveryRider     DeliveryRider?              @relation(fields: [deliveryRiderId], references: [id], onDelete: SetNull)
  orderItem         OrderItem?                  @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  createdAt         DateTime                    @default(now())

  @@index([fulfillmentId, createdAt])
  @@index([orderId, createdAt])
  @@index([actorEmployeeId, createdAt])
  @@index([actorAdminUserId, createdAt])
  @@index([relatedEmployeeId, createdAt])
  @@index([deliveryRiderId, createdAt])
  @@index([orderItemId, createdAt])
}

/**
 * Every customer-code check, right and wrong. A wrong code is the signal that
 * someone is guessing at a doorstep, so it is a row here rather than a counter:
 * the order, the rider, the attempt number and the time all stay auditable.
 * The code itself is never written here, not even the part that was typed.
 */
model CustomerCodeAttempt {
  id               String              @id @default(uuid())
  fulfillmentId    String
  orderId          String
  purpose          CustomerCodePurpose
  succeeded        Boolean
  attemptNumber    Int
  lockedOut        Boolean             @default(false)
  deliveryRiderId  String?
  actorAdminUserId String?
  note             String?
  fulfillment      OrderFulfillment    @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryRider    DeliveryRider?      @relation(fields: [deliveryRiderId], references: [id], onDelete: SetNull)
  actorAdminUser   AdminUser?          @relation("CustomerCodeAttemptActor", fields: [actorAdminUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())

  @@index([fulfillmentId, createdAt])
  @@index([orderId, createdAt])
  @@index([succeeded, createdAt])
  @@index([deliveryRiderId, createdAt])
}

/**
 * Every attempt to recover an order with a phone number and an order number.
 *
 * The lookup is the one place an unauthenticated stranger can ask "does this
 * order exist", so it has to be rate limited, and a limit that lives in one
 * server's memory is no limit at all on Cloud Run. Rows are kept per phone and
 * per caller so a flood against one order and a sweep across many both hit a
 * ceiling. The order number tried is never stored.
 */
model OrderLookupAttempt {
  id              String   @id @default(uuid())
  /// Normalized 2547xxxxxxxx form of the phone the caller claimed.
  normalizedPhone String
  /// Salted hash of the caller's IP. Never the address itself.
  callerHash      String?
  succeeded       Boolean
  createdAt       DateTime @default(now())

  @@index([normalizedPhone, createdAt])
  @@index([callerHash, createdAt])
}

model MpesaCallback {
