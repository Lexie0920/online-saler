  @@index([affiliateId, status, updatedAt])
}

model CollectionItem {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([collectionId, productId])
  @@index([productId])
  @@index([collectionId, sortOrder])
}

model Campaign {
  id           String          @id @default(uuid())
  affiliateId  String
  collectionId String?
  title        String
  slug         String
  channel      CampaignChannel
  source       String
  placement    String
  status       CampaignStatus  @default(DRAFT)
  affiliate    Affiliate       @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  collection   Collection?     @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  shareCards   ShareCard[]
  statusPacks  StatusPack[]
  tiktokVideos TikTokVideo[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([affiliateId, slug])
  @@index([affiliateId, status, createdAt])
  @@index([collectionId])
}

model ShareCard {
  id               String               @id @default(uuid())
  affiliateId      String
  productId        String
  campaignId       String?
  affiliateLink    String
  storageObjectKey String?
  publicUrl        String?
  width            Int                  @default(1200)
  height           Int                  @default(630)
  status           AffiliateAssetStatus @default(PROCESSING)
  affiliate        Affiliate            @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  product          Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  campaign         Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([affiliateId, createdAt])
  @@index([productId, createdAt])
}

model StatusPack {
  id               String               @id @default(uuid())
  affiliateId      String
  collectionId     String
  campaignId       String?
  itemCount        Int
  pageCount        Int
  affiliateLink    String
  storageObjectKey String?
  publicUrl        String?
  status           AffiliateAssetStatus @default(PROCESSING)
  affiliate        Affiliate            @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  collection       Collection           @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  campaign         Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([affiliateId, createdAt])
  @@index([collectionId, createdAt])
}

model TikTokVideo {
  id               String               @id @default(uuid())
  affiliateId      String
  collectionId     String
  campaignId       String?
  durationSeconds  Int                  @default(12)
  affiliateLink    String
  storageObjectKey String?
  publicUrl        String?
  status           AffiliateAssetStatus @default(PROCESSING)
  errorMessage     String?
  affiliate        Affiliate            @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  collection       Collection           @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  campaign         Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([affiliateId, createdAt])
  @@index([collectionId, createdAt])
}

// A silent run-through video of a few pieces, generated for one affiliate.
// Its items record which pieces each video showed, so the next video can pick
// the pieces that have been shown least.
model RunThroughVideo {
  id               String                @id @default(uuid())
  affiliateId      String
  category         String?
  // Daily videos: the Nairobi day (YYYY-MM-DD) and slot they were planned for.
  // Extra videos an affiliate makes on demand have neither.
  day              String?
  slot             Int?
  // Seeds the video's look (cover layout, tone, transition, pace, length).
  seed             Int                   @default(0)
  status           AffiliateAssetStatus  @default(PROCESSING)
  errorMessage     String?
  storageObjectKey String?
  renderStartedAt  DateTime?
  downloadedAt     DateTime?
  affiliate        Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  items            RunThroughVideoItem[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([affiliateId, day, slot])
  @@index([affiliateId, createdAt])
  @@index([status, day])
}

model RunThroughVideoItem {
  videoId   String
  productId String
  position  Int
  video     RunThroughVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([videoId, productId])
  @@index([productId])
}

model Commission {
  id                  String                 @id @default(uuid())
  affiliateId         String
  orderId             String                 @unique
  attributionId       String?                @unique
  status              CommissionStatus       @default(PENDING)
  rateBps             Int
  orderSubtotalKsh    Int
  commissionAmountKsh Int
  adjustments         CommissionAdjustment[]
  eligibleAt          DateTime?
  confirmedAt         DateTime?
  rejectedAt          DateTime?
  paidAt              DateTime?
  holdReason          String?
  note                String?
  /// The weekly M-Pesa payout that paid this commission. Null for commissions
  /// marked paid one by one before weekly payouts existed (2026-10-14).
  payoutId            String?
  payout              Payout?                @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  affiliate           Affiliate              @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  order               Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attribution         AffiliateAttribution?  @relation(fields: [attributionId], references: [id], onDelete: SetNull)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([affiliateId, status, createdAt])
  @@index([status, eligibleAt])
  @@index([payoutId])
}

/// One hand-sent M-Pesa payment (Send Money) to one person for one week, with
/// the transaction code M-Pesa returned. The system never moves the money; it
/// prepares the sheet and records what finance already sent. Every commission
/// and rider fee it covered links back here, so nothing is paid twice.
model Payout {
  id                   String             @id @default(uuid())
  payeeType            PayoutPayeeType
  /// The sheet's grouping key: "affiliate:<id>", "rider:<id>", or for a Bolt /
  /// walk-in rider with no roster entry "external:<phone>|<name>".
  payeeKey             String
  affiliateId          String?
  deliveryRiderId      String?
  payeeName            String
  payeePhone           String?
  amountKsh            Int
  itemCount            Int
  /// M-Pesa transaction code, uppercase. A code can be recorded once only.
  mpesaCode            String             @unique
  periodStart          DateTime
  periodEnd            DateTime
  paidByAdminUserId    String
  paidAt               DateTime           @default(now())
  note                 String?
  affiliate            Affiliate?         @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  deliveryRider        DeliveryRider?     @relation(fields: [deliveryRiderId], references: [id], onDelete: Restrict)
  paidByAdminUser      AdminUser          @relation("PayoutPaidBy", fields: [paidByAdminUserId], references: [id], onDelete: Restrict)
  commissions          Commission[]
  riderFeeFulfillments OrderFulfillment[] @relation("FulfillmentRiderFeePayout")
  createdAt            DateTime           @default(now())

  @@index([payeeType, paidAt])
  @@index([affiliateId, paidAt])
  @@index([deliveryRiderId, paidAt])
  @@index([payeeKey, periodStart])
}

model CustomerServiceCase {
  id                         String                           @id @default(uuid())
  customerId                 String?
  orderId                    String?
  // issueType is the coarse queue the workbench has always grouped by; caseType
  // is the specific reason customer service picks. caseType decides issueType,
  // never the other way round, so old rows and old queues keep working.
  issueType                  CustomerServiceIssueType         @default(OTHER)
  caseType                   CustomerServiceCaseType          @default(OTHER)
  priority                   CustomerServicePriority          @default(NORMAL)
  status                     CustomerServiceCaseStatus        @default(OPEN)
  title                      String
  description                String?
  tags                       Json?
  createdByAdminUserId       String?
  assignedAdminUserId        String?
  assignedEmployeeId         String?
  assignedAt                 DateTime?
  // Escalation is a flag plus a destination, not a status. A case stays OPEN or
  // IN_PROGRESS while it is escalated: it has an extra owner, not a new state.
  escalated                  Boolean                          @default(false)
  escalatedTo                CustomerServiceEscalationTarget?
  escalatedAt                DateTime?
  escalatedByAdminUserId     String?
  escalationNote             String?
  slaDueAt                   DateTime?
  afterSaleReason            String?
  customerRequest            String?
  requiresReturn             Boolean                          @default(false)
  requiresRefund             Boolean                          @default(false)
  affectsAffiliateCommission Boolean                          @default(false)
  resolvedAt                 DateTime?
  closedAt                   DateTime?
  refundRequests             RefundRequest[]
  customer                   Customer?                        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order                      Order?                           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdByAdminUser         AdminUser?                       @relation("CustomerServiceCaseCreatedBy", fields: [createdByAdminUserId], references: [id], onDelete: SetNull)
  assignedAdminUser          AdminUser?                       @relation("CustomerServiceCaseAssignee", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)
  escalatedByAdminUser       AdminUser?                       @relation("CustomerServiceCaseEscalatedBy", fields: [escalatedByAdminUserId], references: [id], onDelete: SetNull)
  assignedEmployee           Employee?                        @relation("CustomerServiceCaseOwner", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  afterSaleReturn            AfterSaleReturn?
  notes                      CustomerServiceNote[]
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt

  @@index([status, issueType, updatedAt])
  @@index([customerId, createdAt])
  @@index([orderId, createdAt])
  @@index([createdByAdminUserId, createdAt])
  @@index([assignedEmployeeId, status, updatedAt])
  @@index([assignedAdminUserId, status, updatedAt])
  @@index([caseType, status, createdAt])
  @@index([escalated, escalatedTo, updatedAt])
  // The overdue queue: open cases past their SLA deadline.
  @@index([status, slaDueAt])
}

model CustomerServiceNote {
  id                String               @id @default(uuid())
  caseId            String?
  customerId        String?
  orderId           String?
  authorAdminUserId String?
  body              String
  tags              Json?
  case              CustomerServiceCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order             Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  authorAdminUser   AdminUser?           @relation("CustomerServiceNoteAuthor", fields: [authorAdminUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())

  @@index([caseId, createdAt])
  @@index([customerId, createdAt])
  @@index([orderId, createdAt])
  @@index([authorAdminUserId, createdAt])
}

enum AfterSaleReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUND_RECORDED
}

enum AfterSaleReturnReason {
  WRONG_ITEM
  PHOTO_MISMATCH
  UNDISCLOSED_DEFECT
  MEASUREMENT_DIFFERENCE
  DELIVERY_DAMAGE
  NOT_SATISFIED
}

enum CommissionAdjustmentKind {
  REVERSAL
  RECOVERY_REQUIRED
}

model AfterSaleReturn {
  id                      String                @id @default(uuid())
  orderId                 String
  orderItemId             String                @unique
  serviceCaseId           String                @unique
  status                  AfterSaleReturnStatus @default(REQUESTED)
  reason                  AfterSaleReturnReason
  measurementDifferenceCm Float?
  requestNote             String
  // The store the customer was told to bring the item back to. Null means the
  // warehouse, which is where every return went before nodes existed.
  returnNodeId            String?
  requestedByAdminUserId  String
  requestedAt             DateTime              @default(now())
  decidedByAdminUserId    String?
  decidedAt               DateTime?
  decisionNote            String?
  receivedByAdminUserId   String?
  receivedAt              DateTime?
  receivedBarcode         String?
  restockable             Boolean?
  inspectionNote          String?
  inventoryUpdatedAt      DateTime?
  restockedAt             DateTime?
  restockedByAdminUserId  String?
  restockedLocationId     String?
  order                   Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem               OrderItem             @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  serviceCase             CustomerServiceCase   @relation(fields: [serviceCaseId], references: [id], onDelete: Restrict)
  returnNode              FulfillmentNode?      @relation("AfterSaleReturnNode", fields: [returnNodeId], references: [id], onDelete: SetNull)
  refundRequests          RefundRequest[]
  refunds                 RefundRecord[]
  commissionAdjustment    CommissionAdjustment?
  events                  AfterSaleEvent[]
  updatedAt               DateTime              @updatedAt

  @@index([orderId, status])
  @@index([status, requestedAt])
  // The list a store opens to see what it should expect back over the counter.
  @@index([returnNodeId, status, requestedAt])
}

/// Customer service asks; finance decides; only then does money move.
///
/// This is deliberately separate from RefundRecord. A RefundRecord is evidence
/// that a refund already happened in M-Pesa; a RefundRequest is permission for
/// it to happen at all. Keeping them apart means customer service can never
/// create the evidence, and finance can never pay out what nobody asked for.
model RefundRequest {
  id                     String               @id @default(uuid())
  orderId                String
  serviceCaseId          String?
  afterSaleReturnId      String?
  status                 RefundRequestStatus  @default(PENDING_APPROVAL)
  kind                   RefundKind           @default(AFTER_SALE_RETURN)
  amountKsh              Int
  reason                 String
  /// Null when the system raised the refund itself — today that is only a
  /// lapsed deposit hold, which expires on a timer with nobody at a desk.
  requestedByAdminUserId String?
  requestedAt            DateTime             @default(now())
  reviewedByAdminUserId  String?
  reviewedAt             DateTime?
  reviewNote             String?
  /// Set when finance records the executed refund; carries the M-Pesa reference.
  refundRecordId         String?              @unique
  completedAt            DateTime?
  cancelledAt            DateTime?
  order                  Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  serviceCase            CustomerServiceCase? @relation(fields: [serviceCaseId], references: [id], onDelete: SetNull)
  afterSaleReturn        AfterSaleReturn?     @relation(fields: [afterSaleReturnId], references: [id], onDelete: SetNull)
  requestedByAdminUser   AdminUser?           @relation("RefundRequestedBy", fields: [requestedByAdminUserId], references: [id], onDelete: Restrict)
  reviewedByAdminUser    AdminUser?           @relation("RefundReviewedBy", fields: [reviewedByAdminUserId], references: [id], onDelete: SetNull)
  refundRecord           RefundRecord?        @relation(fields: [refundRecordId], references: [id], onDelete: SetNull)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([status, requestedAt])
  @@index([orderId, requestedAt])
  @@index([serviceCaseId, requestedAt])
  @@index([requestedByAdminUserId, requestedAt])
}

model RefundRecord {
  id                    String           @id @default(uuid())
  orderId               String
  afterSaleReturnId     String?
  kind                  RefundKind       @default(AFTER_SALE_RETURN)
  reason                String?
  amountKsh             Int
  externalReference     String           @unique
  evidenceNote          String
  refundedAt            DateTime
  recordedByAdminUserId String
  recordedAt            DateTime         @default(now())
  order                 Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  afterSaleReturn       AfterSaleReturn? @relation(fields: [afterSaleReturnId], references: [id], onDelete: Restrict)
  recordedByAdminUser   AdminUser?       @relation("RefundRecordedBy", fields: [recordedByAdminUserId], references: [id], onDelete: Restrict)
  refundRequest         RefundRequest?

  @@index([orderId, recordedAt])
  @@index([kind, recordedAt])
}

model FulfillmentNode {
  id               String                @id @default(uuid())
  code             String                @unique
  name             String
  type             FulfillmentNodeType   @default(STORE)
  status           FulfillmentNodeStatus @default(ACTIVE)
  supportsPickup   Boolean               @default(true)
  supportsDelivery Boolean               @default(true)
  mapsUrl          String?
  address          String?
  phone            String?
  sortOrder        Int                   @default(0)
  note             String?
  orders           Order[]
  fulfillments     OrderFulfillment[]
  staff            Employee[]            @relation("FulfillmentNodeStaff")
  riders           DeliveryRider[]
  returns          AfterSaleReturn[]     @relation("AfterSaleReturnNode")
  notifications    Notification[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([status, sortOrder])
  @@index([type, status])
}

model Notification {
  id                String               @id @default(uuid())
  topic             String
  audience          NotificationAudience
  channel           NotificationChannel  @default(SMS)
  status            NotificationStatus   @default(PENDING)
  dedupeKey         String               @unique
  recipientPhone    String
  recipientLabel    String?
  body              String
  orderId           String?
  affiliateId       String?
  fulfillmentNodeId String?
  attempts          Int                  @default(0)
  nextAttemptAt     DateTime             @default(now())
  lastError         String?
  providerMessageId String?
  provider          String?
  sentAt            DateTime?
  cancelledAt       DateTime?
  order             Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  affiliate         Affiliate?           @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  fulfillmentNode   FulfillmentNode?     @relation(fields: [fulfillmentNodeId], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status, nextAttemptAt])
  @@index([audience, status, createdAt])
  @@index([orderId, createdAt])
  @@index([affiliateId, createdAt])
  @@index([topic, createdAt])
}

model CommissionAdjustment {
  id                    String                   @id @default(uuid())
  commissionId          String
  afterSaleReturnId     String                   @unique
  kind                  CommissionAdjustmentKind
  amountKsh             Int
  beforeAmountKsh       Int
  afterAmountKsh        Int
  recordedByAdminUserId String
  createdAt             DateTime                 @default(now())
  commission            Commission               @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  afterSaleReturn       AfterSaleReturn          @relation(fields: [afterSaleReturnId], references: [id], onDelete: Restrict)

  @@index([commissionId, kind])
}

model AfterSaleEvent {
  id                String          @id @default(uuid())
  orderId           String
  afterSaleReturnId String
  action            String
  actorAdminUserId  String
  sourceApp         SourceApp       @default(OPERATIONS)
  reason            String
  beforeJson        Json
  afterJson         Json
  idempotencyKey    String
  requestHash       String
  createdAt         DateTime        @default(now())
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  afterSaleReturn   AfterSaleReturn @relation(fields: [afterSaleReturnId], references: [id], onDelete: Restrict)

  @@unique([orderId, idempotencyKey])
  @@index([afterSaleReturnId, createdAt])
}
