  orderId                   String?
  providerMerchantRequestId String?
  providerCheckoutRequestId String                        @unique
  resultCode                Int
  resultDescription         String?
  amountKsh                 Int?
  mpesaReceiptNumber        String?
  phone                     String?
  transactionDate           DateTime?
  processingStatus          MpesaCallbackProcessingStatus
  rawJson                   Json
  resolvedByAdminUserId     String?
  resolvedAt                DateTime?
  resolutionNote            String?
  payment                   Payment?                      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  resolvedByAdminUser       AdminUser?                    @relation("MpesaCallbackResolvedBy", fields: [resolvedByAdminUserId], references: [id], onDelete: SetNull)
  createdAt                 DateTime                      @default(now())

  @@index([paymentId, createdAt])
  @@index([orderId, createdAt])
  @@index([mpesaReceiptNumber])
  @@index([processingStatus, resolvedAt, createdAt])
}

